# pii-shield demo: model providers and vault stores.
# Copy to demo/.env.local (git-ignored), fill in what you use, restart `make demo`.
# Keys stay on the demo server; the browser only learns whether a provider is set up.

# Ollama on this machine or on your own server (URL can also be changed in the page)
PII_DEMO_OLLAMA_URL=http://127.0.0.1:11434

# Any OpenAI-compatible server, e.g. vLLM or Ollama's /v1 endpoint on a GPU server
PII_DEMO_GENERIC_URL=
PII_DEMO_GENERIC_KEY=

# Public providers. Detection sends the unredacted text there: use synthetic test data only.
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional vault store, e.g. a local Redis (works with ext-redis or the bundled Predis dev dependency)
PII_DEMO_REDIS_URL=

# ---------- HTTP API (/v1) for apps, see docs/openapi.yaml ----------
# Bearer token. Without it, /v1 accepts requests from localhost only.
PII_SERVICE_TOKEN=
# Optional model for "detection": "model" | "both" (server-side only; requests cannot choose URLs)
PII_SERVICE_MODEL_PROVIDER=
PII_SERVICE_MODEL=
PII_SERVICE_MODEL_URL=
PII_SERVICE_ACKNOWLEDGE_EXTERNAL=false
# filesystem | sqlite | redis
PII_SERVICE_VAULT_STORE=filesystem
# file (demo/var/learned-types.json) | redis
PII_SERVICE_LEARNED_STORE=file
# Extra host names the HTTP API answers to (comma-separated), e.g. when it runs behind a reverse proxy
PII_SERVICE_ALLOWED_HOSTS=
