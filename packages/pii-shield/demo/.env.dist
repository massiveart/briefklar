# pii-shield demo: model providers and vault stores.
# Copy to demo/.env.local (git-ignored), fill in what you use, restart `make demo`.
# Keys stay on the demo server; the browser only learns whether a provider is set up.

# Ollama on this machine or on your own server (URL can also be changed in the page)
PII_DEMO_OLLAMA_URL=http://127.0.0.1:11434

# Any OpenAI-compatible server, e.g. vLLM or Ollama's /v1 endpoint on a GPU server
PII_DEMO_GENERIC_URL=
PII_DEMO_GENERIC_KEY=

# Public providers. Detection sends the unredacted text there: use synthetic test data only.
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional vault store
PII_DEMO_REDIS_URL=
