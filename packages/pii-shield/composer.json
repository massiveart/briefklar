{
  "name": "briefklar/pii-shield",
  "description": "Reversible PII redaction for Symfony AI with DACH recognizers (AT SVNR, IBAN, tax numbers) and checksum validation.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "symfony-ai",
    "pii",
    "gdpr",
    "dsgvo",
    "redaction",
    "anonymization",
    "llm"
  ],
  "require": {
    "php": ">=8.4",
    "ext-sodium": "*",
    "psr/cache": "^3.0",
    "psr/clock": "^1.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.35",
    "mcp/sdk": "0.9.0",
    "nyholm/psr7": "^1.8",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-phpunit": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.1",
    "phpstan/phpstan-symfony": "^2.1",
    "phpunit/phpunit": "^12.0",
    "predis/predis": "^3.7",
    "symfony/ai-agent": "1.0.0-BETA1",
    "symfony/ai-anthropic-platform": "1.0.0-BETA1",
    "symfony/ai-bundle": "1.0.0-BETA1",
    "symfony/ai-generic-platform": "1.0.0-BETA1",
    "symfony/ai-mistral-platform": "1.0.0-BETA1",
    "symfony/ai-ollama-platform": "1.0.0-BETA1",
    "symfony/ai-open-ai-platform": "1.0.0-BETA1",
    "symfony/ai-platform": "1.0.0-BETA1",
    "symfony/browser-kit": "^8.1",
    "symfony/cache": "^8.1",
    "symfony/clock": "^8.1",
    "symfony/css-selector": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/mcp-bundle": "1.0.0-BETA1",
    "symfony/yaml": "^8.1"
  },
  "suggest": {
    "symfony/framework-bundle": "To use PiiShieldBundle (config/packages/pii_shield.yaml)",
    "symfony/ai-agent": "To use PiiShieldProcessor in Symfony AI agents",
    "symfony/ai-platform": "To use ModelDetector with any model",
    "symfony/ai-ollama-platform": "Model-based detection with a local or on-premise Ollama",
    "symfony/ai-generic-platform": "Model-based detection with any OpenAI-compatible server (vLLM, ...)",
    "symfony/ai-mistral-platform": "Model-based detection with Mistral (external, needs acknowledgement)",
    "psr/cache-implementation": "To persist encrypted vaults (e.g. symfony/cache with Redis, filesystem or PDO)"
  },
  "autoload": {
    "psr-4": {
      "Briefklar\\PiiShield\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Briefklar\\PiiShield\\Tests\\": "tests/",
      "Briefklar\\PiiShield\\Demo\\": "demo/src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "cs-check": "php-cs-fixer check --diff",
    "cs-fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse --no-progress",
    "qa": [
      "@cs-check",
      "@phpstan"
    ],
    "demo": [
      "Composer\\Config::disableProcessTimeout",
      "APP_ENV=dev PHP_CLI_SERVER_WORKERS=4 php -S 127.0.0.1:8088 -t demo/public demo/public/index.php"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
