{
  "name": "briefklar/pii-shield",
  "description": "Reversible PII redaction for Symfony AI with DACH recognizers (AT SVNR, IBAN, tax numbers) and checksum validation.",
  "type": "library",
  "license": "MIT",
  "keywords": ["symfony-ai", "pii", "gdpr", "dsgvo", "redaction", "anonymization", "llm"],
  "require": {
    "php": ">=8.4",
    "ext-sodium": "*",
    "psr/cache": "^3.0",
    "psr/clock": "^1.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-phpunit": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.1",
    "phpunit/phpunit": "^12.0",
    "symfony/cache": "^8.1",
    "symfony/clock": "^8.1"
  },
  "suggest": {
    "symfony/ai-agent": "To use the input/output processors in Symfony AI agents",
    "symfony/ai-platform": "To use the NER detector via Hugging Face"
  },
  "autoload": {
    "psr-4": { "Briefklar\\PiiShield\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Briefklar\\PiiShield\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "cs-check": "php-cs-fixer check --diff",
    "cs-fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse --no-progress",
    "qa": ["@cs-check", "@phpstan"]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
