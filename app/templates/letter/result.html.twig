{% extends 'base.html.twig' %}

{% set e = result.explanation %}

{% block title %}{{ 'letter.result.title'|trans }}{% endblock %}

{% block body %}
    <p class="sender">{{ e.sender }}</p>
    <h1>{{ e.subject }}</h1>

    <section class="deadline card {{ e.deadline is null ? 'deadline--none' : (result.deadlineStatedInLetter ? '' : 'deadline--unverified') }}" aria-labelledby="deadline-heading">
        <h2 id="deadline-heading">{{ 'letter.result.deadline'|trans }}</h2>
        {% if e.deadline is null %}
            <p>{{ 'letter.result.no_deadline'|trans }}</p>
        {% else %}
            <p class="deadline__value">{{ e.deadline }}</p>
            {% if not result.deadlineStatedInLetter %}
                <p class="warning" role="note">
                    {# Lucide "triangle-alert" #}
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                    <span>{{ 'letter.result.deadline_unverified'|trans }}</span>
                </p>
            {% endif %}
        {% endif %}
    </section>

    {% if e.amount is not null %}
        <p class="amount"><span class="amount__label">{{ 'letter.result.amount'|trans }}</span> <strong class="amount__value">{{ e.amount }}</strong></p>
    {% endif %}

    <section class="result-section" aria-labelledby="summary-heading">
        <h2 id="summary-heading">{{ 'letter.result.summary'|trans }}</h2>
        <p class="prose">{{ e.summary }}</p>
    </section>

    <section class="result-section" aria-labelledby="actions-heading">
        <h2 id="actions-heading">{{ 'letter.result.actions'|trans }}</h2>
        {% if e.actionRequired and e.actions is not empty %}
            <ol class="actions">
                {% for action in e.actions %}<li><span>{{ action }}</span></li>{% endfor %}
            </ol>
        {% else %}
            <p>{{ 'letter.result.no_action'|trans }}</p>
        {% endif %}
    </section>

    {% if e.questionsToAsk is not empty %}
        <section class="result-section" aria-labelledby="questions-heading">
            <h2 id="questions-heading">{{ 'letter.result.questions'|trans }}</h2>
            <ul class="questions">{% for question in e.questionsToAsk %}<li>{{ question }}</li>{% endfor %}</ul>
        </section>
    {% endif %}

    {% if e.legalReferences is not empty %}
        <section class="result-section" aria-labelledby="references-heading">
            <h2 id="references-heading">{{ 'letter.result.legal_references'|trans }}</h2>
            <ul class="references">{% for reference in e.legalReferences %}<li class="tag tag-neutral">{{ reference }}</li>{% endfor %}</ul>
        </section>
    {% endif %}

    <aside class="disclaimer">
        <p>{{ 'letter.result.disclaimer'|trans }}</p>
        {% if result.extractionMethod.value == 'ocr' %}<p>{{ 'letter.result.ocr_note'|trans }}</p>{% endif %}
    </aside>

    <p class="result-again"><a class="btn btn-primary" href="{{ path('letter_upload') }}">{{ 'letter.result.again'|trans }}</a></p>
{% endblock %}
