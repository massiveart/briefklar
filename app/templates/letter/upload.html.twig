{% extends 'base.html.twig' %}

{% block title %}{{ 'letter.upload.title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'letter.upload.title'|trans }}</h1>
    <p class="lead">{{ 'letter.upload.intro'|trans }}</p>

    {# Turbo Drive expects a redirect after POST; we do not store letters, so there is nothing to redirect to. #}
    {{ form_start(form, {attr: {'data-turbo': 'false'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.letter) }}
        <button type="submit">{{ 'letter.upload.submit'|trans }}</button>
    {{ form_end(form) }}

    <p class="privacy">{{ 'letter.privacy'|trans }}</p>
{% endblock %}
