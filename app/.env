# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/ai-anthropic-platform ###
ANTHROPIC_API_KEY=
###< symfony/ai-anthropic-platform ###

###> symfony/ai-generic-platform ###
# GENERIC_BASE_URL=https://api.example.com/v1
###< symfony/ai-generic-platform ###

###> symfony/ai-hugging-face-platform ###
HUGGINGFACE_API_KEY=
###< symfony/ai-hugging-face-platform ###

###> app/extraction ###
# Local OCR binaries (installed in the app container). Override for a host install, e.g. /opt/homebrew/bin/tesseract
TESSERACT_BINARY=tesseract
PDFTOPPM_BINARY=pdftoppm
###< app/extraction ###

###> app/ai ###
# Which platform and model explain letters. Put API keys into .env.local, never here.
#   huggingface: HUGGINGFACE_API_KEY, e.g. AI_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
#   anthropic:   ANTHROPIC_API_KEY,   e.g. AI_MODEL=claude-sonnet-5-5
#   ollama:      local, no key,       e.g. AI_MODEL=qwen3:8b (docker compose --profile local up -d)
AI_PLATFORM=huggingface
AI_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
OLLAMA_ENDPOINT=http://ollama:11434
# Seconds a model may take for one explanation (local models need 30-40 s on a laptop).
EXPLANATION_TIMEOUT=120
# Model-based PII detection on the local Ollama (OLLAMA_ENDPOINT), in addition to the patterns.
# Finds names without salutation and one-line addresses; needs a running Ollama with the model.
PII_MODEL_DETECTION=0
PII_DETECTION_MODEL=qwen3:8b
# Payment QR code (EPC, "Zahlen mit Code") on the result page, from the IBAN and amount in the letter itself.
# Off by default: it is the one feature where a wrong value could cost money.
PAYMENT_QR=0
# Folder the MCP tool explain_letter_file may read letters from (PDF, PNG, JPG, TIFF). Empty: the tool is off.
# In Docker it is a path inside the container, e.g. /srv/app/var/letters.
MCP_LETTER_DIR=
###< app/ai ###
